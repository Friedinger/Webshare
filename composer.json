{
	"name": "webshare/webshare",
	"description": "A simple, lightweight, self hosted webservice to easily share files and links via an short custom URL.",
	"license": "MIT",
	"require-dev": {
		"phpunit/phpunit": "^10",
		"infection/infection": "^0.28.1"
	},
	"config": {
		"allow-plugins": {
			"infection/extension-installer": true
		}
	},
	"scripts": {
		"test": "vendor/bin/phpunit",
		"infection": "vendor/bin/infection --min-msi=100 --min-covered-msi=100 --threads=4"
	}
}
